{
  "name": "wordclock",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./public/assets/css/main.css --minify",
    "build:js": "cp src/js/app.js public/assets/js/main.js",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./public/assets/css/main.css --watch",
    "dev": "npm run build:js && npm run watch:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.8",
    "tailwindcss": "^4.1.8"
  }
}
